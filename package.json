{
  "name": "pdf-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite",
    "prebuild": "npm run assets",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "desktop": "npm run build && electron .",
    "desktop:win": "npm run build && electron-builder --win",
    "test:desktop": "node tests/e2e/desktop.mjs"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.1",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@cantoo/fontkit": "^2.0.12",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "buffer": "^6.0.3",
    "diff": "^9.0.0",
    "docx": "^9.11.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.57.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "node-forge": "^1.4.0",
    "pdf-lib": "npm:@cantoo/pdf-lib@2.11.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zustand": "^5.0.15"
  },
  "main": "electron/main.cjs",
  "description": "Leitor e editor de PDF com OCR e assinatura digital",
  "author": "Geir23",
  "build": {
    "appId": "io.github.geir23.pdfstudio",
    "productName": "PDF Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "Documento PDF",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PDF Studio",
      "artifactName": "PDF-Studio-${version}-instalador.${ext}"
    },
    "portable": {
      "artifactName": "PDF-Studio-${version}-portatil.exe"
    },
    "linux": {
      "target": [
        "dir"
      ]
    }
  }
}
